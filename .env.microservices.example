# Microservices Configuration Template
# Copy this to .env and update values

# API Gateway
PORT=3000

# Microservices Ports
AUTH_SERVICE_PORT=3001
PRODUCTS_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003
CART_SERVICE_PORT=3004
ADMIN_SERVICE_PORT=3005

# Service URLs (for service-to-service communication)
AUTH_SERVICE_URL=http://localhost:3001
PRODUCTS_SERVICE_URL=http://localhost:3002
ORDERS_SERVICE_URL=http://localhost:3003
CART_SERVICE_URL=http://localhost:3004
ADMIN_SERVICE_URL=http://localhost:3005

# =====================================================
# PostgreSQL Configuration (AWS RDS)
# =====================================================
# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plants_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# AWS RDS PostgreSQL Example:
# DB_HOST=your-rds-endpoint.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=plants_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password_here
# DB_SSL=true

# =====================================================
# JWT Configuration
# =====================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=30d

# =====================================================
# Admin Account Setup (auto-created on first run)
# =====================================================
ADMIN_EMAIL=admin@plantsnursery.com
ADMIN_PASSWORD=Admin@123
ADMIN_DEFAULT_NAME=Admin
ADMIN_CREATION_KEY=your-admin-creation-secret-key

# Docker Configuration (for docker-compose)
MONGO_USERNAME=admin
MONGO_PASSWORD=password
